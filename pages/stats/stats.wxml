<view class="page stats-page">
  <view class="range-tabs">
    <button class="tab {{rangeDays === 7 ? 'active' : ''}}" data-range="7" bindtap="switchRange">近 7 天</button>
    <button class="tab {{rangeDays === 30 ? 'active' : ''}}" data-range="30" bindtap="switchRange">近 30 天</button>
  </view>

  <view class="section metric-row">
    <view class="panel metric">
      <view class="metric-label">总数</view>
      <view class="metric-value">{{summary.total}} 支</view>
    </view>
    <view class="panel metric">
      <view class="metric-label">日均</view>
      <view class="metric-value">{{summary.average}} 支</view>
    </view>
  </view>

  <view class="section metric-row">
    <view class="panel metric">
      <view class="metric-label">超标天数</view>
      <view class="metric-value">{{summary.overTargetDays}} 天</view>
    </view>
    <view class="panel metric">
      <view class="metric-label">估算花费</view>
      <view class="metric-value">¥{{summary.estimatedCost}}</view>
    </view>
  </view>

  <view class="section panel compare">
    <view class="compare-main">{{compareText}}</view>
    <view class="subtle">当前每日目标：{{summary.target}} 支</view>
  </view>

  <view class="section panel chart">
    <view class="chart-title">{{rangeDays}} 天趋势</view>
    <view class="bar-row" wx:for="{{summary.daily}}" wx:key="date">
      <view class="bar-label">{{item.label}}</view>
      <view class="bar-track">
        <view class="bar-fill {{item.overTarget ? 'over' : ''}}" style="width: {{item.percent}}%;"></view>
      </view>
      <view class="bar-count">{{item.count}}</view>
    </view>
  </view>
</view>
