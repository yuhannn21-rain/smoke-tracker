.range-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #e8eeeb;
}

.tab {
  min-height: 72rpx;
  color: #59635f;
  background: transparent;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.tab.active {
  color: #ffffff;
  background: #1f7a70;
}

.compare {
  padding: 28rpx;
}

.compare-main {
  margin-bottom: 8rpx;
  color: #1f2a28;
  font-size: 36rpx;
  font-weight: 800;
}

.chart {
  padding: 28rpx;
}

.chart-title {
  margin-bottom: 24rpx;
  color: #1f2a28;
  font-size: 34rpx;
  font-weight: 800;
}

.bar-row {
  display: grid;
  grid-template-columns: 86rpx 1fr 54rpx;
  align-items: center;
  gap: 14rpx;
  min-height: 44rpx;
  margin-top: 12rpx;
}

.bar-label,
.bar-count {
  color: #6e7771;
  font-size: 22rpx;
}

.bar-count {
  text-align: right;
}

.bar-track {
  height: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e3e9e6;
}

.bar-fill {
  height: 100%;
  min-width: 4rpx;
  border-radius: 999rpx;
  background: #1f7a70;
}

.bar-fill.over {
  background: #cc5b49;
}
