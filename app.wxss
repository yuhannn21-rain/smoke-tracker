page {
  min-height: 100%;
  background: #f5f7f6;
  color: #1f2a28;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 48rpx;
}

.section {
  margin-top: 28rpx;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e2e8e5;
  border-radius: 16rpx;
  box-shadow: 0 12rpx 36rpx rgba(31, 42, 40, 0.06);
}

.eyebrow {
  color: #6e7771;
  font-size: 24rpx;
  line-height: 1.4;
}

.title {
  margin-top: 8rpx;
  color: #18211f;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.18;
}

.subtle {
  color: #6e7771;
  font-size: 26rpx;
  line-height: 1.5;
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.primary-button {
  color: #ffffff;
  background: #1f7a70;
  box-shadow: 0 14rpx 30rpx rgba(31, 122, 112, 0.22);
}

.secondary-button {
  color: #1f2a28;
  background: #ecf1ef;
}

.danger-button {
  color: #ffffff;
  background: #cc5b49;
}

button::after {
  border: none;
}

.metric-row {
  display: flex;
  gap: 18rpx;
}

.metric {
  flex: 1;
  min-width: 0;
  padding: 24rpx;
}

.metric-label {
  color: #6e7771;
  font-size: 24rpx;
}

.metric-value {
  margin-top: 10rpx;
  color: #1f2a28;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.1;
}
